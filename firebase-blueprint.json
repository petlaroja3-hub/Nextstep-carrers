      "required": [
        "title",
        "level",
        "category",
        "duration",
        "eligibility",
        "description",
        "subjects",
        "studyPathways",
        "careerOpportunities",
        "furtherEducation",
        "entranceExams",
        "admissionProcess",
        "officialSourceName",
        "officialUrl",
        "state",
        "published",
        "isSampleData",
        "lastVerifiedDate",
        "createdAt",
        "updatedAt"
