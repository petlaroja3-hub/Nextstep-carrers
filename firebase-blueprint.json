      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "titleTe": { "type": "string", "minLength": 0, "maxLength": 250 },
        "level": { "type": "string", "enum": ["after_10th", "after_inter"] },
        "category": { "type": "string", "minLength": 2, "maxLength": 100 },
        "duration": { "type": "string", "minLength": 2, "maxLength": 100 },
        "eligibility": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "eligibilityTe": { "type": "string", "minLength": 0, "maxLength": 1200 },
