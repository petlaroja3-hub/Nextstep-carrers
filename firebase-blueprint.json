        "studyPathways": { "type": "array", "description": "Available study pathways (max 15)" },
        "careerOpportunities": { "type": "array", "description": "Potential career opportunities (max 15)" },
        "furtherEducation": { "type": "array", "description": "Further study options (max 15)" },
        "entranceExams": { "type": "array", "description": "Relevant entrance exams (max 15)" },
