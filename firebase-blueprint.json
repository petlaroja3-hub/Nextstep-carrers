        "officialSourceName": { "type": "string", "minLength": 2, "maxLength": 200 },
        "officialUrl": { "type": "string", "minLength": 5, "maxLength": 500 },
        "state": { "type": "string", "enum": ["Andhra Pradesh", "Telangana", "All India", "AP & TG"] },
        "published": { "type": "boolean" },
        "isSampleData": { "type": "boolean" },
        "lastVerifiedDate": { "type": "string", "minLength": 4, "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
