  "firestore": {
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Courses after Class 10 and Intermediate"
    },
    "/courseCategories/{categoryId}": {
      "schema": "CourseCategory",
      "description": "Course category definitions"
    },
    "/entranceExams/{examId}": {
      "schema": "EntranceExam",
      "description": "State and national entrance examinations"
    },
    "/colleges/{collegeId}": {
      "schema": "College",
      "description": "Colleges and universities directory"
    },
    "/scholarships/{scholarshipId}": {
      "schema": "Scholarship",
      "description": "State and central scholarships"
    },
    "/careers/{careerId}": {
      "schema": "Career",
      "description": "Career pathways and options"
    },
    "/careerUpdates/{updateId}": {
      "schema": "CareerUpdate",
      "description": "Verified official education updates and announcements"
    },
    "/officialSources/{sourceId}": {
      "schema": "OfficialSource",
      "description": "Configured government and exam websites for verification"
    },
    "/verificationHistory/{logId}": {
      "schema": "VerificationLog",
      "description": "Audit logs of official website verification runs"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "In-site verified notifications"
    },
    "/userPreferences/{userId}": {
      "schema": "UserPreference",
      "description": "Private user career planner preferences and read notifications"
    },
    "/adminRoles/{adminUid}": {
